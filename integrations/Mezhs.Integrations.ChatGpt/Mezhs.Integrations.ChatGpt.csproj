<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Mezhs.Integration.Browser\Mezhs.Integration.Browser.csproj" />
  </ItemGroup>
  <!-- Package all browser source modules before embedding the single deployed JavaScript resource. -->
  <Target Name='BundleChatGptBrowser' BeforeTargets='PrepareResourceNames'>
    <Exec Command='node &quot;$(MSBuildProjectDirectory)/browser/build.js&quot;' />
  </Target>
  <ItemGroup>
    <EmbeddedResource Include="browser\chatgpt.ts" LogicalName="Mezhs.Integrations.ChatGpt.BrowserModule" />
  </ItemGroup>
</Project>
